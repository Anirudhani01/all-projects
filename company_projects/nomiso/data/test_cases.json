                    1001
                ]
            },
            "string_lengths": {
                "username": {
                    "min": 3,
                    "max": 50
                },
                "product_name": {
                    "min": 1,
                    "max": 255
                },
                "description": {
                    "min": 1,
                    "max": 1000
