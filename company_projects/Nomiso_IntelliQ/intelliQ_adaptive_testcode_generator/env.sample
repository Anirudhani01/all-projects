# Sample environment variables for IntelliQ Adaptive Test Code Generator

# OpenAI API Key (required for AI-driven code generation)
OPENAI_API_KEY=your-openai-api-key-here

# Appium server URL (if using Appium)
APPIUM_SERVER_URL=http://localhost:4723

# Selenium server URL (if using remote Selenium)
SELENIUM_SERVER_URL=http://localhost:4444/wd/hub

# Example credentials (if required by your test context)
USERNAME=your-username
PASSWORD=your-password

# Add any other environment variables required by your test cases or framework below
APP_USERNAME
DEFAULT_TIMEOUT
ELEMENT_TIMEOUT
SCREENSHOTS_DIRECTORY
LLM_RESPONSES_DIRECTORY
LOG_LEVEL=info
PAGE_LOAD_TIMEOUT
STEP_WAIT_TIME
EXECUTION_TIMEOUT
SCRIPTS_DIRECTORY
REPORTS_DIRECTORY
LOGS_DIRECTORY
OPENAI_MODEL=gpt-4


# OpenAI Configuration
OPENAI_API_KEY=xxx
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=6000
OPENAI_TIMEOUT=30
OPENAI_ENABLE_FALLBACK=true

# Application Under Test Configuration
BASE_URL=http://localhost:8080/opencrx-core-CRX
APP_USERNAME=admin-Standard
APP_PASSWORD=admin-Standard

# WebDriver Configuration
HEADLESS_MODE=false
BROWSER_TYPE=chrome
CHROME_DRIVER_PATH=C:\Users\naave\OneDrive\Desktop\Selenium_automation_script_generator\chromedriver\chromedriver.exe
WINDOW_SIZE=1920x1080

# Test Configuration
DEFAULT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=30
SCREENSHOT_ON_FAILURE=true

# Output Configuration
OUTPUT_DIRECTORY=selenium
REPORTS_DIRECTORY=reports
SCREENSHOTS_DIRECTORY=screenshots
LLM_RESPONSES_DIRECTORY=llm_responses

# Logging Configuration  
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
