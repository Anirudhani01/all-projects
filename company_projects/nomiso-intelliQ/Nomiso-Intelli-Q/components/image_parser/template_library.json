  "template": {
    "page": {
      "name": "GeneralPage",
      "description": "Fallback layout used when the screen doesn't match known types (form, table, list, menu, card, etc.). Extracts content in a layout-agnostic way from visual blocks.",
      "layout_description": "Describe general layout structure based on what is visible: is it centered text, side-by-side blocks, a document-like flow, etc.",
      "content_type": "email | document | static_screen | banner | code | visual | unknown — Infer the dominant content type using visible clues.",

      "visual_blocks": [
        {
          "id": "block_00",
          "type": "text | image | banner | heading | icon | visual",
          "label": "If a title, label, or heading is present for the block",
          "value": "Extract visible content or text inside this block",
          "size": "small | medium | large — estimate based on visual area",
          "alignment": "left | center | right",
          "highlighted": "true | false — If it stands out (e.g., bold, shadow, colored)",
          "metadata": {
            "x": "Relative X from top-left of screen",
            "y": "Relative Y from top-left of screen",
            "width": "Width of block as relative proportion",
            "height": "Height of block as relative proportion",
            "font_style": "bold | italic | monospace | regular",
            "font_size": "in px or relative size if visible",
            "background_color": "#Hex — background of block",
            "text_color": "#Hex — visible font color",
            "border_style": "solid | dashed | none",
            "icon_present": "true | false",
            "image_alt": "For images/logos: describe what the image shows if guessable"
          }
        }
      ],

      "images_or_icons": [
        {
          "type": "logo | inline_icon | background_image | decorative",
          "metadata": {
            "x": "Relative X position",
            "y": "Relative Y position",
            "width": "Width in relative terms",
            "height": "Height in relative terms",
            "dominant_color": "#Hex",
            "size": "small | medium | large",
            "alt_text": "Extract any visible or guessed label if relevant"
          }
        }
      ],

      "observed_indicators": [
        {
          "type": "error_banner | info_message | warning_box | status_text",
          "message": "Text of the visible message if applicable",
          "style": "alert | subtle | boxed",
          "metadata": {
            "x": "Relative X of indicator",
            "y": "Relative Y of indicator",
            "width": "Relative width of indicator",
            "height": "Relative height of indicator",
            "color": "#Hex",
            "icon": "If any symbol is shown"
          }
        }
      ],

      "extra_metadata": {
        "scrollbar_present": "true | false",
        "timestamp_visible": "true | false",
        "source_label": "If source app, URL, or brand is visible",
        "code_detected": "true | false",
        "logo_detected": "true | false",
        "keyword_hints": ["invoice", "feedback", "preview", "locked", "success"]
      }
    }
  }
},
  "diagram": {
  "template": {
    "page": {
      "name": "FlowchartPage",
      "description": "This screen represents a diagrammatic workflow or logical flow using shapes (e.g., rectangles, diamonds), connectors, arrows, and labeled nodes. Often used to visualize business logic, data pipelines, or process maps.",
      "diagram_mode": "view | edit | interactive | static",
      "state": "empty | loading | populated | error",
      "grid_visible": true,
      "snap_to_grid": true,
      "flow_direction": "top-down",
      "section_order": ["Authentication Flow", "Notifications"],
      "directional_links": [
        {
          "from": "start_node",
          "to": "decision_node",
          "label": "Initiate",
          "direction": "uni",
          "style": "solid",
          "description": "Primary entry path in the process."
        },
        {
          "from": "decision_node",
          "to": "success_node",
          "label": "Yes",
          "direction": "uni",
          "style": "solid",
          "description": "Path taken when condition is satisfied."
        },
        {
          "from": "decision_node",
          "to": "fail_node",
          "label": "No",
          "direction": "uni",
          "style": "dotted",
          "description": "Path taken when condition fails."
        }
      ],
      "tools": [
        {
          "name": "zoom_control",
          "type": "icon_button",
          "description": "Magnifies or shrinks diagram area.",
          "position": "top-right",
          "metadata": {
            "icon": "+",
            "tooltip": "Zoom in",
            "enabled": true
          }
        },
        {
          "name": "fit_to_screen",
          "type": "button",
          "description": "Rescales and centers entire diagram.",
          "position": "top",
          "metadata": {
            "enabled": true,
            "tooltip": "Reset view"
          }
        }
      ],
      "sections": [
        {
          "name": "Authentication Flow",
          "description": "Labeled section grouping related nodes.",
          "highlighted": true,
          "background_shade": "light-blue",
          "flow_order": ["start_node", "decision_node", "success_node", "fail_node"],
          "direction": "top-down",
          "elements": [
            {
              "name": "start_node",
              "type": "shape",
              "shape": "circle",
              "label": "Start",
              "position": {
                "x": 0.1,
                "y": 0.1
              },
              "parent": null,
              "children": ["decision_node"],
              "operations": [],
              "metadata": {
                "color": "green",
                "border_style": "solid",
                "text_alignment": "center"
              }
            },
            {
              "name": "decision_node",
              "type": "shape",
              "shape": "diamond",
              "label": "Check condition",
              "position": {
                "x": 0.5,
                "y": 0.3
              },
              "parent": "start_node",
              "children": ["success_node", "fail_node"],
              "operations": ["Evaluate condition"],
              "metadata": {
                "color": "yellow",
                "border_style": "solid",
                "text_alignment": "center",
                "icon": "❓"
              }
            },
            {
              "name": "success_node",
              "type": "shape",
              "shape": "rectangle",
              "label": "Access Granted",
              "position": {
                "x": 0.8,
                "y": 0.3
              },
              "parent": "decision_node",
              "children": [],
              "operations": ["Grant access"],
              "metadata": {
                "color": "#d4edda",
                "border_style": "solid",
                "text_alignment": "center"
              }
            },
            {
              "name": "fail_node",
              "type": "shape",
              "shape": "rectangle",
              "label": "Access Denied",
              "position": {
                "x": 0.5,
                "y": 0.6
              },
              "parent": "decision_node",
              "children": [],
              "operations": ["Reject user"],
              "metadata": {
                "color": "#f8d7da",
                "border_style": "dashed",
                "text_alignment": "center"
              }
            }
          ]
        },
        {
          "name": "Notifications",
          "description": "Floating area showing secondary flows.",
          "highlighted": false,
          "flow_order": ["note_box"],
          "direction": "none",
          "elements": [
            {
              "name": "note_box",
              "type": "annotation",
              "label": "Note",
              "position": {
                "x": 0.9,
                "y": 0.9
              },
              "operations": [],
              "metadata": {
                "text": "This flow represents onboarding steps.",
                "background_color": "#f8f9fa",
                "border_color": "#ced4da",
                "font_style": "italic"
              }
            }
          ]
        }
      ]
    }
  }
