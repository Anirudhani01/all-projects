{
  "info": {
    "name": "PayLater FastAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Merchant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Flipkart\", \"fee\": 2.5}"
        },
        "url": {
          "raw": "http://localhost:8000/merchants/",
          "host": [
            "http://localhost:8000"
          ],
          "path": [
            "merchants",
            ""
          ]
        }
      }
    },
    {
      "name": "Update Merchant Fee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"merchant_id\": 1, \"new_fee\": 3.0}"
        },
        "url": {
          "raw": "http://localhost:8000/merchants/update_fee",
          "host": [
            "http://localhost:8000"
          ],
          "path": [
            "merchants",
            "update_fee"
          ]
        }
      }
    },
